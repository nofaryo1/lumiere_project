# Copy this file to ".env" and fill in your own value. Never commit the real .env.
#
# MongoDB connection string (MongoDB Atlas or a local MongoDB).
# The database name ("lumiere") is set in server.js, so it isn't part of this string.
#   Atlas example:  mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
#   Local example:  mongodb://127.0.0.1:27017
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
