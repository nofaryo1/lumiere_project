{
  "name": "lumiere_project",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild server.jsx seed/seed.jsx --bundle --platform=node --packages=external --format=cjs --target=node20 --outdir=dist --outbase=. --log-level=warning",
    "build:client": "esbuild client/pages/app.jsx --bundle --format=esm --jsx=automatic --minify --sourcemap --target=es2020 --outdir=public/build --log-level=warning",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "seed:community": "npm run build:server && node dist/seed/seed.js community",
    "seed:groups": "npm run build:server && node dist/seed/seed.js groups"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "d3": "7.9.0",
    "dotenv": "^18.0.6",
    "esbuild": "0.25.0",
    "express": "^5.2.1",
    "jquery": "3.7.1",
    "mongoose": "^9.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.8.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
